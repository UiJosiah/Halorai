## Backend env vars
#
# Copy to `backend/.env` and fill in values.

# CORS: browser origins allowed to call this API (no "*"). Use your frontend URL(s).
# Production: same host(s) users open in the address bar (e.g. Vercel), comma-separated.
# Example: https://halorai.vercel.app,https://www.example.com
# Local dev: leave unset to allow http://localhost:8080 (Vite in this repo) and other common dev ports.
CORS_ORIGINS=

# Optional single-URL alias for CORS_ORIGINS (if you only need one origin).
# Also used in plugin upload response as preview_page (e.g. https://halorai.vercel.app/plugin-preview).
# FRONTEND_ORIGIN=

# Gemini API key (preferred name for this project)
GEMINI_API_KEY=

# Optional alternative name supported by Google tooling
# GOOGLE_API_KEY=

# Optional: backend AI defaults (override without code changes)
# Best text model (concept generation, reasoning)
AI_TEXT_MODEL=models/gemini-3.1-pro-preview

# Best fast image model ("Nano Banana 2" = Gemini 3.1 Flash Image)
# For max quality you can switch to: models/nano-banana-pro-preview (or models/gemini-3-pro-image-preview)
AI_IMAGE_MODEL=models/gemini-3.1-flash-image-preview

# Flyer generation model (defaults to AI_IMAGE_MODEL)
# AI_FLYER_MODEL=models/gemini-3.1-flash-image-preview

# Optional: choose which provider to use.
# - gemini: force Gemini
# - openai: force OpenAI
# - auto: try the provider that matches the model name, and failover on quota/rate-limit errors
AI_PROVIDER=auto

# OpenAI (optional fallback)
OPENAI_API_KEY=
# Run: python backend/scripts/list_models_openai.py for your account’s best picks
OPENAI_TEXT_MODEL=gpt-5.4
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_FLYER_MODEL=gpt-image-1.5

# Optional: where to read template folders from
AI_TEMPLATES_DIR=C:\path\to\Templates


# Max number of minister images allowed
AI_MAX_MINISTERS=3

# Cloudinary (test-flyer plugin JSON — image URLs)
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Or set the three vars below:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_UPLOAD_FOLDER=halorai/test-flyer

# Optional: require X-Plugin-Key header on POST /api/plugin/flyer-result (production)
# PLUGIN_API_KEY=
